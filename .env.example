# Порт локального сервера
PORT=3000

# --- Yandex Cloud Foundation Models (YandexGPT) ---
# Как получить: console.cloud.yandex.ru -> сервисный аккаунт -> API-ключ (Api-Key)
# folder_id берётся из каталога Yandex Cloud, в котором создан сервисный аккаунт.
# Если оставить пустыми — бот работает в детерминированном сценарии из раздела 9
# инструкции без обращения к внешней модели (mock-режим), это нормально для локальной разработки.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_GPT_MODEL=yandexgpt-lite

# --- Интеграция с Битрикс24 (crm.lead.add) ---
# Входящий вебхук в Битрикс24: CRM -> Добавить вкладку -> Вебхуки -> Входящий вебхук.
# Укажите либо полный URL метода crm.lead.add, либо базовый адрес вебхука
# (…/rest/<user_id>/<token>/), метод добавится автоматически.
# Пустое значение — интеграция отключена, лид пишется только в data/leads.jsonl.
BITRIX24_WEBHOOK_URL=
# ID ответственного сотрудника в Битрикс24 (необязательно, число)
BITRIX24_ASSIGNED_BY_ID=

# --- Переменные продукта (раздел 0 системной инструкции) ---
# Пустое значение = "не заполнено" -> бот использует нейтральную формулировку
# и передаёт вопрос специалисту, но не выдумывает данные.
BOT_NAME=ИИ-консультант ГлавИнструмента
PRODUCT_NAME=Умный чат для сайта
COMPANY_LEGAL_NAME=
PRIVACY_POLICY_URL=
PD_CONSENT_URL=
DEMO_DURATION=
DEMO_LIMITS=
CURRENT_PRICE_DATA=
MANAGER_WORKING_HOURS=
MANAGER_RESPONSE_SLA=
CALENDAR_URL=
SUPPORT_CHANNEL=
PUBLIC_DEMO_URL=
