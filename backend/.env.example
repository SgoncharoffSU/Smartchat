DATABASE_URL="postgresql://smartchat:smartchat@localhost:5432/smartchat?schema=public"

# Yandex Cloud Foundation Models (YandexGPT)
YANDEX_API_KEY="your-yandex-cloud-api-key"
YANDEX_FOLDER_ID="your-yandex-cloud-folder-id"
YANDEX_GPT_MODEL="yandexgpt-lite"

PORT=3000

# Comma-separated list of widget message rate limits
WIDGET_SESSION_RATE_LIMIT=10
WIDGET_BOT_RATE_LIMIT=60

# Cabinet auth (sign/verify the cabinet session cookie) + provisioning
JWT_SECRET="change-me-to-a-long-random-string"
PUBLIC_BASE_URL="https://chat.glavinstrument.com"
PROVISIONING_RATE_LIMIT_PER_DAY=3
